#version 460
// Shadow culling: every shadow view with its bit set in `view_mask` gets a frustum-only culled,
// LOD-selected command list (views 2..9). One thread handles one instance for all views.
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#include "cull.glsl"

layout(push_constant, std430) uniform Push { Params params; Commands commands; Counts counts; } pc;
layout(local_size_x = 64) in;

void main() {
    Params P = pc.params;
    Counts counts = pc.counts;
    uint i = gl_GlobalInvocationID.x;
    if (i >= P.p.instance_count) return;
    Instance inst = P.p.instances.i[i];
    if ((inst.flags & 12u) != 8u) return;        // blended objects do not cast shadows
    MeshRecord m = P.p.meshes.m[inst.mesh];
    uint lod = 0xffffffffu;
    for (uint k = 0u; k < 8u; ++k) {
        if ((P.p.view_mask & (1u << k)) == 0u || !in_frustum(P, 1u + k, inst.sphere)) continue;
        if (lod == 0xffffffffu) lod = select_lod(P, m, inst);
        emit_draw(P, pc.commands, counts, 2u + k, inst.flags & 3u, m, lod, i, 0u);
        atomicAdd(counts.c[STATS + 6u], 1u);
    }
}
