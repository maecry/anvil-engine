#version 460
#extension GL_EXT_buffer_reference : require
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Out { uint v[]; };
layout(push_constant, std430) uniform Push { Out dst; uint count; uint mul; } pc;
layout(local_size_x = 64) in;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.count) pc.dst.v[i] = i * pc.mul;
}
